# Which LLM answers chat questions:
#   ollama     - runs on this machine; no document text leaves it (default)
#   openrouter - sends each question plus the retrieved passages to OpenRouter
LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# MODEL_NAME=qwen2.5:14b          # default per provider: qwen2.5:14b (ollama), gpt-4o (openrouter)

# Only needed when LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Chainlit Authentication (login is required; with no username/password set, every login is refused)
# Generate the secret using: chainlit create-secret
CHAINLIT_AUTH_SECRET=your_chainlit_auth_secret_here
CHAINLIT_AUTH_USERNAME=your_username_here
CHAINLIT_AUTH_PASSWORD=your_password_here

# Optional: Directory Configuration (relative paths resolve against the repo root)
# DATA_DIR=./data
# CHROMA_PERSIST_DIR=./chroma_db
# CHROMA_COLLECTION=irp_docs

# Optional: Model Configuration
# TEMPERATURE=0
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: Retrieval tuning
# Passages sent to the LLM per question, and the token size/overlap of the chunks
# documents are split into. RETRIEVAL_TOP_K x CHUNK_SIZE must stay <= 6144 so the
# passages, prompt and answer fit Ollama's 8192-token context window.
# Changing CHUNK_SIZE or CHUNK_OVERLAP takes effect only after: py -m rag refresh
# RETRIEVAL_TOP_K=6
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64

# Optional: Chat History Configuration
# ENABLE_CHAT_HISTORY=true
# MAX_CHAT_HISTORY=50
# CHAT_STORAGE_DIR=./chat_history

# Optional: opt out of library telemetry (none of it includes document content)
# ANONYMIZED_TELEMETRY=False      # ChromaDB usage events
# DO_NOT_TRACK=1                  # unstructured's version/OS ping
# HF_HUB_DISABLE_TELEMETRY=1      # Hugging Face download telemetry
